# Copia este archivo a .env.local (ya está en .gitignore) y llena los
# valores reales de tu proyecto de Supabase (Project Settings > API).
# Estas dos claves viajan al navegador (por eso el prefijo NEXT_PUBLIC_) —
# es la anon key pública, diseñada para exponerse siempre que Row Level
# Security esté activo en las tablas, como en supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — la clave "secret" de Project Settings > API (NO la anon
# key). Se salta Row Level Security por completo y da acceso total a la
# Admin API de Auth. SOLO se usa en código de servidor (lib/supabase/admin.ts,
# hoy usado por la sección Accesos del panel para crear administradores).
# Nunca debe llevar el prefijo NEXT_PUBLIC_ — eso la mandaría al navegador.
SUPABASE_SERVICE_ROLE_KEY=
