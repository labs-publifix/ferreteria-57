# Copia este archivo a .env.local (ya está en .gitignore) y llena los
# valores reales de tu proyecto de Supabase (Project Settings > API).
# Estas dos claves viajan al navegador (por eso el prefijo NEXT_PUBLIC_) —
# es la anon key pública, diseñada para exponerse siempre que Row Level
# Security esté activo en las tablas, como en supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role — la clave "secret" de Project Settings > API (NO la anon
# key). Se salta Row Level Security por completo y da acceso total a la
# Admin API de Auth. SOLO se usa en código de servidor (lib/supabase/admin.ts,
# hoy usado por la sección Accesos del panel para crear administradores).
# Nunca debe llevar el prefijo NEXT_PUBLIC_ — eso la mandaría al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Resend (dashboard de Resend > API Keys) — usada por
# lib/email/sendEmail.ts para los correos transaccionales de pedidos
# (notificación interna + confirmación al cliente). Dominio
# ferreteria57.com ya verificado (DKIM + SPF), remitente pedidos@ferreteria57.com.
RESEND_API_KEY=

# Destinatarios adicionales (coma-separados) que reciben copia de los
# correos internos del negocio (nuevo pedido, nuevo canje de Club 57 — ver
# lib/email/businessRecipients.ts) además de la lista base ya hardcodeada
# ahí — no la reemplaza, se suma a ella. Si no se define, cae en
# ferreteria57qro@gmail.com. Un fallo al mandar esta copia nunca rompe el
# correo al destinatario principal ni el flujo del pedido/canje.
ORDER_NOTIFICATION_EXTRA_RECIPIENTS=

# Mecanismo de emergencia para pruebas puntuales: si esta variable existe,
# TODO correo de la app (sin excepción) se redirige a esta dirección en
# vez de a su destinatario real, sin cambiar el asunto ni el cuerpo. No
# debe existir en producción — el dominio ya está verificado, así que los
# correos deben llegar a sus destinatarios reales sin este atajo.
EMAIL_OVERRIDE=

# Dominio público del sitio (sin slash final), usado por SEO: canonical
# tags, sitemap.xml, robots.txt y metadataBase de Open Graph — ver
# lib/seo.ts. Mientras ferreteria57.com no resuelva, deja esta variable
# vacía y el sitio cae solo al dominio que Vercel ya asigna a cada
# deployment; en cuanto el dominio final esté conectado, pon aquí
# https://ferreteria57.com (sin slash al final) y todo lo de SEO se
# actualiza sin tocar código.
NEXT_PUBLIC_SITE_URL=

# --- Club 57: aviso por email de promociones (lib/club57/avisos) ---
# Interruptor general. Con "false" (default) no se muestra el paso de aviso,
# el cron no envía nada y la app se comporta igual que antes.
CLUB57_PROMO_EMAILS_ENABLED=false
# Secreto del cron diario (Vercel lo manda como "Authorization: Bearer ...").
# Sin él, /api/cron/club57-avisos responde 401 siempre.
CRON_SECRET=
# Tope diario TOTAL de la cuenta de correo (transaccionales + avisos) y la
# reserva que siempre queda libre para pedidos y canjes. Avisos por día =
# RESEND_DAILY_LIMIT - RESEND_TRANSACTIONAL_RESERVE. Para ampliar capacidad
# basta con subir RESEND_DAILY_LIMIT.
RESEND_DAILY_LIMIT=100
RESEND_TRANSACTIONAL_RESERVE=20
# Tope mensual: solo genera una advertencia neutra en el panel.
RESEND_MONTHLY_LIMIT=3000
# Opcionales: remitente de los avisos (mismo dominio verificado) y secreto
# para firmar los enlaces de baja (si no se define, se deriva de
# SUPABASE_SERVICE_ROLE_KEY).
CLUB57_PROMO_EMAIL_FROM=
CLUB57_EMAIL_TOKEN_SECRET=

# --- Blog ---
# "1" muestra los artículos PROGRAMADOS (publishAt en el futuro) con aviso de
# vista previa y noindex. Solo funciona fuera de producción (VERCEL_ENV !==
# "production"): ponerla en Preview de Vercel para revisar artículos antes
# de su fecha. En producción se ignora siempre.
BLOG_SHOW_SCHEDULED=
